VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

MILESIGHT_WEBHOOK_SECRET=CHANGE_ME
ADMIN_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD

# Milesight Development Platform Open API (server-side only)
MILESIGHT_API_BASE_URL=https://us-openapi.milesight.com
MILESIGHT_CLIENT_ID=YOUR_MILESIGHT_CLIENT_ID
MILESIGHT_CLIENT_SECRET=YOUR_MILESIGHT_CLIENT_SECRET

# Optional: use one of these if the Application contains more than one gateway.
# Otherwise the backend automatically finds the SG50 gateway.
MILESIGHT_GATEWAY_DEVICE_ID=
MILESIGHT_GATEWAY_DEVEUI=
